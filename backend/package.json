{
    "name": "medata-platform-backend",
    "version": "2.0.0",
    "private": true,
    "description": "Enterprise-ready backend for MeData platform",
    "main": "src/server.js",
    "scripts": {
        "dev": "node src/server.js",
        "migrate": "node src/scripts/migrate.js",
        "cleanup:ingestion-job-runs": "node src/scripts/cleanup-ingestion-job-runs.js",
        "seed": "node src/scripts/seed.js",
        "seed:lab-models": "node src/scripts/seed-lab-model-profiles.js",
        "seed:data-standards": "node src/scripts/seed-data-standards-baseline.js",
        "setup:preview": "bash ../scripts/install-preview-dependencies.sh",
        "verify:datax-enterprise": "node ../scripts/verify-datax-enterprise-plugins.js",
        "bootstrap": "node src/scripts/bootstrap.js",
    "test": "node --test src/common/utils/async-handler.test.js src/common/utils/web-core-adapter.test.js src/modules/data-standards/*.test.js src/modules/data-services/*.test.js src/modules/data-sources/*.test.js src/services/*.test.js",
        "test:data-services": "node --test src/modules/data-services/*.test.js",
        "test:quality": "node --test src/modules/quality-control/*.test.js",
        "backfill:quality-results": "node src/scripts/backfill-quality-result-facts.js",
        "backfill:incubations": "node src/scripts/backfill-incubation-enhancements.js",
        "repair:gov-zero-padded-codes": "node src/scripts/repair-gov-project-zero-padded-codes.js",
        "regression:dynamic-modules": "node src/scripts/run-dynamic-module-planner-regression.js",
        "regression:zero-config": "node src/scripts/run-zero-config-six-industry-regression.js",
        "build:secure": "node src/scripts/obfuscate-runtime.js",
        "start:secure": "node dist-secure/server.js"
    },
    "dependencies": {
        "@johnason/data-platform-core": "0.2.0",
        "@johnason/data-platform-core-kernel": "0.2.0",
        "basic-ftp": "^5.3.1",
        "bcryptjs": "^2.4.3",
        "cors": "^2.8.5",
        "dmdb": "^1.0.52452",
        "docx": "^9.6.1",
        "dotenv": "^16.4.5",
        "express": "^4.19.2",
        "helmet": "^8.1.0",
        "hive-driver": "^1.0.0",
        "iconv-lite": "^0.6.3",
        "javascript-obfuscator": "^4.1.1",
        "jsonwebtoken": "^9.0.2",
        "kafkajs": "^2.2.4",
        "mammoth": "^1.8.0",
        "morgan": "^1.10.0",
        "multer": "^2.1.1",
        "mysql2": "^3.11.3",
        "node-cron": "^3.0.3",
        "node-opengauss": "^1.1.0",
        "node-sql-parser": "^5.3.8",
        "oracledb": "^7.0.1",
        "pdf-parse": "^1.1.1",
        "pg": "^8.13.3",
        "uuid": "^9.0.1",
        "word-extractor": "^1.0.4",
        "xlsx": "^0.18.5",
        "xml-js": "^1.6.11",
        "zod": "^3.24.1"
    }
}
